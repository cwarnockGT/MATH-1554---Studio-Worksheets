<?xml version="1.0" encoding="UTF-8"?>
<worksheet xml:id="section-1-4-temp">
  <title>Worksheet 1.4, The Matrix Equation</title>

  <page>
    <exercise xml:id="section-1-4-temp-ex-1" workspace="2in"><introduction>
      <p> <m>\operatorname{Span}\{\vec v_1,\vec v_2\}</m> is equal to which of the expressions below?</p>
      
        <p><m>\operatorname{Span}\{\vec v_1,\vec v_2, 3\vec v_1\}</m></p>
        <p><m>\operatorname{Span}\{\vec v_1, 3\vec v_1\}</m></p>
        <p><m>\operatorname{Span}\{\vec v_1,\vec v_2, 3\vec v_1 + 2\vec v_2\}</m></p>
      
    </introduction></exercise>

    <exercise xml:id="section-1-4-temp-ex-2" workspace="2in"><statement>
      <p> For what values of <m>h</m> is <m>\vec b</m> in the plane spanned by <m>\vec a_1</m> and <m>\vec a_2</m>?</p>
      <p>
        <md>
        \vec a_1 = \begin{pmatrix} 1 \\ 4 \\ -1 \end{pmatrix},\quad
        \vec a_2 = \begin{pmatrix} -6 \\ -17 \\ 2 \end{pmatrix},\quad
        \vec b = \begin{pmatrix} 4 \\ 2 \\ h \end{pmatrix}
        </md>
      </p>
    </statement></exercise>

    <exercise xml:id="section-1-4-temp-ex-3" workspace="2in"><introduction>
      <p> Indicate whether the statements are true or false.</p>
      
        <p>
          If the equation <m>A\vec x = \vec b</m> is inconsistent, then
          <m>\vec b</m> is not in the set spanned by the columns of <m>A</m>.
        </p>
        <p>
          If the augmented matrix <m>[\,A\ \vec b\,]</m> has a pivot position
          in every row, then the equation <m>A\vec x = \vec b</m> must be
          consistent.
        </p>
        <p>
          There are exactly three vectors in
          <m>\operatorname{Span}\{\vec a_1,\vec a_2,\vec a_3\}</m>.
        </p>
      
    </introduction></exercise>
  </page>
</worksheet>