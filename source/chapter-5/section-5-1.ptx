<?xml version="1.0" encoding="UTF-8"?>
<worksheet xml:id="section-5-1">
  <title>Worksheet 5.1, Eigenvectors and Eigenvalues</title>

  <page>

    <!-- Exercise 1 -->
    <exercise xml:id="section-5-1-ex-1" workspace="2in"><statement>
      <p> Determine whether <m>\vec u</m> and <m>\vec v</m> are eigenvectors of <m>A</m>. 
      If so, what are their eigenvalues? Do not find the characteristic polynomial.</p>

      <p>
        <md>
        A =
        \begin{pmatrix}
          -3 &amp; -3 &amp; 2 \\
           6 &amp;  4 &amp; 0 \\
           5 &amp;  3 &amp; 0
        \end{pmatrix},
        \quad
        \vec u =
        \begin{pmatrix}
          -1 \\ 1 \\ 1
        \end{pmatrix},
        \quad
        \vec v =
        \begin{pmatrix}
          1 \\ 1 \\ 1
        \end{pmatrix}
        </md>
      </p>
    </statement></exercise>

    <!-- Exercise 2 -->
    <exercise xml:id="section-5-1-ex-2" workspace="2in"><introduction>
      <p> <m>T</m> is a linear transformation in <m>\mathbb{R}^2</m>. 
      Without constructing <m>A</m>, identify one eigenvalue of <m>A</m>.</p>
      
    </introduction><task><statement><p><m>T</m> reflects points across the line <m>x_1 = -x_2</m>.</p></statement></task><task><statement><p><m>T</m> projects points onto one of the coordinate axes.</p></statement></task></exercise>

    </page>
    <page>

    <!-- Exercise 3 -->
    <exercise xml:id="section-5-1-ex-3" workspace="2in"><statement>
      <p> If <m>A\vec v = \lambda \vec v</m> with <m>\vec v \ne \vec 0</m> and <m>A</m> is invertible, 
      can you find an eigenvalue and eigenvector of <m>A^{-1}</m>? 
      Can <m>A</m> have a zero eigenvalue?</p>
    </statement></exercise>

    <!-- Exercise 4 -->
    <exercise xml:id="section-5-1-ex-4" workspace="2in"><statement>
      <p> Is <m>\lambda = 2</m> an eigenvalue of <m>A</m>? 
      Do not compute the characteristic polynomial.</p>

      <p>
        <md>
        A =
        \begin{pmatrix}
          3 &amp; 2 \\
          3 &amp; 8
        \end{pmatrix}
        </md>
      </p>
    </statement></exercise>

  </page>
</worksheet>