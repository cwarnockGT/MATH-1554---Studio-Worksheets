<?xml version="1.0" encoding="UTF-8"?>
<worksheet xml:id="section-5-5">
  <title>Worksheet 5.5, Complex Eigenvalues</title>

  <page>

    <!-- Exercise 1 -->
    <exercise xml:id="section-5-5-ex-1" workspace="2in"><introduction>
      <p> Indicate whether the statements are true or false.</p>
      
    </introduction><task><statement><p>There exists a real <m>2 \times 2</m> matrix with the eigenvalues <m>i</m> and <m>2i</m>.</p></statement></task><task><statement><p>Every real <m>3 \times 3</m> matrix must have a real eigenvalue.</p></statement></task></exercise>

    <!-- Exercise 2 -->
    <exercise xml:id="section-5-5-ex-2" workspace="2in"><statement>
      <p> <m>A</m> is a composition of a rotation and a scaling.
      Give the angle of rotation <m>\varphi</m> and the scale factor <m>r</m>.</p>

      <p>
        <md>
        A =
        \begin{pmatrix}
          \sqrt{3} &amp; -1 \\
          1 &amp; \sqrt{3}
        \end{pmatrix}
        </md>
      </p>
    </statement></exercise>

    <!-- Exercise 3 -->
    <exercise xml:id="section-5-5-ex-3" workspace="2in"><statement>
      <p> Matrix <m>A</m> is a <m>2 \times 2</m> matrix that satisfies</p>

      <p>
        <md>
        A^2 + 2A = -6I_2
        </md>
      </p>

      <p>where <m>I_2</m> is the <m>2 \times 2</m> identity matrix.
      Compute the eigenvalues of <m>A</m>.</p>
    </statement></exercise>

    <!-- Exercise 4 -->
    <exercise xml:id="section-5-5-ex-4" workspace="2in"><statement>
      <p> <em>Written Explanation Exercise</em>
      Can a <m>7 \times 7</m> matrix have <m>2</m> real eigenvalues and <m>5</m> non‑real eigenvalues?
      If <m>A</m> is an <m>n \times n</m> matrix and <m>n</m> is odd, why does <m>A</m> have a real eigenvalue?</p>
    </statement></exercise>

  </page>
</worksheet>