<?xml version="1.0" encoding="UTF-8"?>
<worksheet xml:id="section-7-2">
  <title>Worksheet 7.2, Quadratic Forms</title>

  <page>

    <!-- Exercise 1 -->
    <exercise xml:id="section-7-2-ex-1" workspace="2in"><introduction>
      <p> Indicate whether the statements are true or false.</p>
      
    </introduction><task><statement>
          <p>
            <m>3x^2 - 8xy + 3y^2 \ge 0</m> for all real values of <m>x</m> and <m>y</m>.
          </p>
        </statement></task><task><statement>
          <p>
            The quadratic form
            <m>Q = -x^2 - 2xy - y^2</m>
            is negative semidefinite.
          </p>
        </statement></task></exercise>

    <!-- Exercise 2 -->
    <exercise xml:id="section-7-2-ex-2" workspace="2in"><statement>
      <p> Assume <m>\vec{x} \in \mathbb{R}^3</m>.
      Construct the matrix of the quadratic form, and classify the quadratic form</p>

      <p>
        <md>
        Q = 4x_3^2 - 2x_1x_2.
        </md>
      </p>
    </statement></exercise>

</page>
<page>

    <!-- Exercise 3 -->
    <exercise xml:id="section-7-2-ex-3" workspace="2in"><statement>
      <p> Make a change of variables that transforms the quadratic form into another quadratic form that has no cross‑product term.</p>

      <p>
        <md>
        Q = x_1^2 - 12x_1x_2 - 4x_2^2.
        </md>
      </p>
    </statement></exercise>

    <!-- Exercise 4 -->
    <exercise xml:id="section-7-2-ex-4" workspace="2in"><statement>
      <p> <em>Written Explanation Exercise</em>.
      Let <m>Q(\vec{x}) = A\vec{x} \cdot \vec{x}</m>, where <m>A</m> is a symmetric <m>n \times n</m> matrix
      with eigenvalues <m>\lambda_1,\dots,\lambda_n</m>.
      Explain how to find a change of variables so that <m>Q</m> becomes
        <md>
        P(\vec{y}) = \lambda_1 y_1^2 + \cdots + \lambda_n y_n^2.
        </md></p>
    </statement></exercise>

  </page>
</worksheet>