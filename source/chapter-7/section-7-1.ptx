<?xml version="1.0" encoding="UTF-8"?>
<worksheet xml:id="section-7-1">
  <title>Worksheet 7.1, Diagonalization of Symmetric Matrices</title>

  <page>

    <!-- Exercise 1 -->
    <exercise xml:id="section-7-1-ex-1" workspace="2in"><statement>
      <p> Construct a spectral decomposition for <m>A = PDP^T</m>.</p>

      <p>
        <md>
        A =
        \begin{pmatrix}
          1 &amp; -5 \\
          -5 &amp; 1
        \end{pmatrix},
        \quad
        P = \tfrac{1}{\sqrt{2}}
        \begin{pmatrix}
          -1 &amp; 1 \\
           1 &amp; 1
        \end{pmatrix},
        \quad
        D =
        \begin{pmatrix}
          6 &amp; 0 \\
          0 &amp; -4
        \end{pmatrix}
        </md>
      </p>
    </statement></exercise>

    <!-- Exercise 2 -->
    <exercise xml:id="section-7-1-ex-2" workspace="2in"><introduction>
      <p> If possible, give an example of:</p>
      
    </introduction><task><statement>
          <p>
            a matrix <m>A \in \mathbb{R}^{2 \times 2}</m> that is diagonalizable
            but not orthogonally diagonalizable.
          </p>
        </statement></task><task><statement>
          <p>
            a matrix <m>A \in \mathbb{R}^{2 \times 2}</m> that is orthogonally diagonalizable
            but not invertible.
          </p>
        </statement></task><task><statement>
          <p>
            any matrix that is diagonalizable but not invertible.
          </p>
        </statement></task></exercise>
</page>
<page>

    <!-- Exercise 3 -->
    <exercise xml:id="section-7-1-ex-3" workspace="2in"><introduction>
      <p> Indicate whether the statements are true or false.</p>
      
    </introduction><task><statement>
          <p>
            If <m>A</m> is orthogonally diagonalizable, then so is <m>A^2</m>.
          </p>
        </statement></task><task><statement>
          <p>
            For any matrix <m>A \in \mathbb{R}^{m \times n}</m>,
            both <m>AA^T</m> and <m>A^T A</m> are symmetric matrices.
          </p>
        </statement></task></exercise>

    <!-- Exercise 4 -->
    <exercise xml:id="section-7-1-ex-4" workspace="2in"><statement>
      <p> The only eigenvalues of <m>A</m> are <m>7</m> and <m>-2</m>.</p>

      <p>
        <md>
        A =
        \begin{pmatrix}
          3 &amp; -2 &amp; 4 \\
          -2 &amp; 6 &amp; 2 \\
          4 &amp; 2 &amp; 3
        \end{pmatrix}
        </md>
      </p>

      <p>
        Construct matrices <m>P</m> and <m>D</m> for the orthogonal diagonalization
        <m>A = PDP^T</m>.
        Hints: you may want to use the Gram–Schmidt process to construct <m>P</m>.
        Since <m>P</m> is an orthogonal matrix, what do the lengths of each column of <m>P</m> need to be?
      </p>
    </statement></exercise>

  </page>
</worksheet>