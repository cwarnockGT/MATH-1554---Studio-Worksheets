<?xml version="1.0" encoding="UTF-8"?>
<worksheet xml:id="section-1-5">
  <title>Worksheet 1.5, Solution Sets of Linear Systems</title>

  <page>

    <exercise xml:id="section-1-5-ex-1" workspace="2in"><introduction>
      <p> <em>Written Explanation Exercise</em></p>
      
    </introduction><task><statement>
          <p>When a homogeneous system has a nontrivial solution, what properties does that system have? List at least two.</p>
        </statement></task></exercise>

    <exercise xml:id="section-1-5-ex-2" workspace="2in"><introduction>
      <p> Indicate whether the statements are true or false.</p>
      
    </introduction><task><statement>
          <p>A non‑trivial solution <m>\vec{x}</m> to <m>A\vec{x} = \vec{0}</m> has all non‑zero entries.</p>
        </statement></task><task><statement>
          <p>If <m>A\vec{x} = \vec{b}</m> and <m>A\vec{y} = \vec{b}</m>, then <m>A(\vec{x} - \vec{y}) = \vec{0}</m>.</p>
        </statement></task><task><statement>
          <p>Any <m>3 \times 2</m> matrix <m>A</m> with two pivotal positions has a non‑trivial solution to <m>A\vec{x} = \vec{0}</m>.</p>
        </statement></task></exercise>

</page>

<page>

    <exercise xml:id="section-1-5-ex-3" workspace="2in"><introduction>
      <p> <em> Example Construction </em> </p>
      
    </introduction><task><statement>
          <p>
            Give an example of a non‑zero <m>2 \times 3</m> matrix <m>A</m> such that
            <m>\vec{x} = \begin{pmatrix}1 \\ 2 \\ 1\end{pmatrix}</m> is a solution of <m>A\vec{x} = \vec{0}</m>.
          </p>
        </statement></task><task><statement>
          <p>
            Give an example of a non‑trivial solution to <m>A\vec{x} = \vec{0}</m>, where
            <m>A = \begin{pmatrix}2 &amp; 5 \\ 0 &amp; 0 \\ 4 &amp; 10\end{pmatrix}</m>.
          </p>
        </statement></task></exercise>

    <exercise xml:id="section-1-5-ex-4" workspace="2in"><statement>
      <p> Express the solution to <m>A\vec{x} = \vec{0}</m> in parametric vector form, where</p>
      <p>
        <md>
        A =
        \begin{pmatrix}
        1 &amp; 3 &amp; 4 &amp; 1 \\
        0 &amp; 0 &amp; 1 &amp; 1
        \end{pmatrix}
        </md>.
      </p>
    </statement></exercise>

  </page>
</worksheet>