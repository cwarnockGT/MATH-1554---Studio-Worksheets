<?xml version="1.0" encoding="UTF-8"?>
<worksheet xml:id="section-1-4">
  <title>Worksheet 1.4, The Matrix Equation</title>

  <page>

    <exercise xml:id="section-1-4-ex-1" workspace="2in"><introduction>
      <p> <m>\operatorname{Span}\{\vec v_1,\vec v_2\}</m> is equal to which of the expressions below?</p>
      
    </introduction><task><statement><p><m>\operatorname{Span}\{\vec v_1,\vec v_2, 3\vec v_1\}</m></p></statement></task><task><statement><p><m>\operatorname{Span}\{\vec v_1, 3\vec v_1\}</m></p></statement></task><task><statement><p><m>\operatorname{Span}\{\vec v_1,\vec v_2, 3\vec v_1 + 2\vec v_2\}</m></p></statement></task></exercise>

    <exercise xml:id="section-1-4-ex-2" workspace="3in"><statement>
      <p> For what values of <m>h</m> is <m>\vec b</m> in the plane spanned by <m>\vec a_1</m> and <m>\vec a_2</m>?</p>
      <p>
        <md>
        \vec a_1 = \begin{pmatrix}1 \\ 4 \\ -1\end{pmatrix},\quad
        \vec a_2 = \begin{pmatrix}-6 \\ -17 \\ 2\end{pmatrix},\quad
        \vec b = \begin{pmatrix}4 \\ 2 \\ h\end{pmatrix}
        </md>
      </p>
    </statement></exercise>

    <exercise xml:id="section-1-4-ex-3" workspace="1in"><introduction>
      <p> Indicate whether the statements are true or false.</p>
      
    </introduction><task><statement><p>If the equation <m>A\vec x = \vec b</m> is inconsistent, then <m>\vec b</m> is not in the set spanned by the columns of <m>A</m>.</p></statement></task><task><statement><p>If the augmented matrix <m>[\,A \, |  \, \vec b\,]</m> has a pivot position in every row, then the equation <m>A\vec x = \vec b</m> must be consistent.</p></statement></task><task><statement><p>There are exactly three vectors in <m>\operatorname{Span}\{\vec a_1,\vec a_2,\vec a_3\}</m>.</p></statement></task></exercise>

  </page>
</worksheet>