<?xml version="1.0" encoding="UTF-8"?>
<worksheet xml:id="section-2-9">
  <title>Worksheet 2.9, Dimension and Rank</title>

  <page>

    <exercise xml:id="section-2-9-ex-1" workspace="2in"><introduction>
      <p> True or false.</p>
      
    </introduction><task><statement><p>All <m>2 \times 4</m> matrices have a non‑trivial null space.</p></statement></task><task><statement><p>A <m>4 \times 2</m> matrix with two pivot columns can have a non‑trivial null space.</p></statement></task><task><statement><p>If the columns of a <m>6 \times 6</m> matrix <m>A</m> are a basis for <m>\mathbb{R}^6</m>, the null space of <m>A</m> is the zero vector.</p></statement></task></exercise>

    <exercise xml:id="section-2-9-ex-2" workspace="2in"><introduction>
      <p> <m>A</m> is an <m>n \times n</m> matrix that has elements <m>a_{ij}</m> where</p>

      <p>
        <md>
        a_{ij} =
        \begin{cases}
          0, &amp; \text{when } i + j \text{ is odd} \\
          1, &amp; \text{when } i + j \text{ is even}
        \end{cases}
        </md>
      </p>

      <p>Suppose <m>n \ge 2</m>.</p>
      
    </introduction><task><statement><p>What is the rank of <m>A</m>?</p></statement></task><task><statement><p>Give a basis for the column space of <m>A</m>.</p></statement></task></exercise>

  </page>
</worksheet>