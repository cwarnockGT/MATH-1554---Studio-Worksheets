<?xml version="1.0" encoding="UTF-8"?>
<worksheet xml:id="section-2-4">
  <title>Worksheet 2.4, Partitioned Matrices</title>

  <page>

    <exercise xml:id="section-2-4-ex-1" workspace="2in"><statement>
      <p> <m>A</m> and <m>B</m> are <m>n \times n</m> invertible matrices, <m>I_n</m> is the <m>n \times n</m> identity matrix, and <m>0</m> is the <m>n \times n</m> zero matrix. Construct an expression for <m>X</m> in terms of <m>A</m> and <m>B</m>.</p>

      <p>
        <md>
        \begin{pmatrix}
          A &amp; B 
        \end{pmatrix}
        \begin{pmatrix}
          0 &amp; X &amp; B \\
          A &amp; B &amp; 0
        \end{pmatrix}
        =
        \begin{pmatrix}
          X \\
          I_n \\
          BA 
        \end{pmatrix}
        =
        B^2 + BAX
        </md>
      </p>
    </statement></exercise>

  </page>
</worksheet>