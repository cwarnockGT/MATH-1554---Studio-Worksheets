<?xml version="1.0" encoding="UTF-8"?>
<worksheet xml:id="section-2-8">
  <title>Worksheet 2.8, Subspaces of <m>\mathbb{R}^n</m></title>

  <page>

    <exercise xml:id="section-2-8-ex-1" workspace="2in"><statement>
      <p> <m>A</m> has the reduced echelon form below. Construct a basis for <m>\mathrm{Col}(A)</m> and for <m>\mathrm{Nul}(A)</m>.</p>

      <p>
        <md>
        A = \begin{pmatrix} \vec a_1 &amp; \vec a_2 &amp; \vec a_3 &amp; \vec a_4 &amp; \vec a_5 &amp; \vec a_6 \end{pmatrix} \sim 
        \begin{pmatrix}
          1 &amp; 4 &amp; 0 &amp; 10 &amp; 0 &amp; 13 \\
          0 &amp; 0 &amp; 1 &amp; -3 &amp; 0 &amp; -5 \\
          0 &amp; 0 &amp; 0 &amp; 0 &amp; 1 &amp; 4 \\
          0 &amp; 0 &amp; 0 &amp; 0 &amp; 0 &amp; 0
        \end{pmatrix}.
        </md>
      </p>
    </statement></exercise>

    <exercise xml:id="section-2-8-ex-2" workspace="2in"><introduction>
      <p> Which of these are bases for their relevant spaces?</p>
      
    </introduction><task><statement>
          <p>
            <m>\begin{pmatrix} 5 \\ -2 \end{pmatrix},
               \begin{pmatrix} 10 \\ -2 \end{pmatrix}</m>
          </p>
        </statement></task><task><statement>
          <p>
            <m>
            \begin{pmatrix} 2 \\ * \\ * \\ * \end{pmatrix},\ 
            \begin{pmatrix} 0 \\ 2 \\ * \\ * \end{pmatrix},\ 
            \begin{pmatrix} 0 \\ 0 \\ 2 \\ * \end{pmatrix},\ 
            \begin{pmatrix} 0 \\ 0 \\ 0 \\ 2 \end{pmatrix}
            </m>,
            where <m>*</m> is arbitrary
          </p>
        </statement></task><task><statement>
          <p>
            <m>
            \begin{pmatrix} 1 \\ 1 \\ 2 \end{pmatrix},\ 
            \begin{pmatrix} -5 \\ -1 \\ 2 \end{pmatrix},\ 
            \begin{pmatrix} 7 \\ 3 \\ h \end{pmatrix}
            </m>,
            where <m>h</m> is arbitrary
          </p>
        </statement></task></exercise>
</page>
<page>

    <exercise xml:id="section-2-8-ex-3" workspace="1in"><statement>
      <p> Construct a <m>3 \times 3</m> matrix <m>A</m> with two pivotal columns so that <m>\begin{pmatrix}1 \\ 1 \\ 1\end{pmatrix}</m> is in the null space of <m>A</m>.</p>
    </statement></exercise>

    <exercise xml:id="section-2-8-ex-4" workspace="2in"><introduction>
      <p> Which of the following, if any, are subspaces of <m>\mathbb{R}^3</m>? For those that are subspaces, what is the dimension of the subspace?</p>
      

    </introduction><task><statement>
          <p>
            <m>
            \left\{
              \begin{pmatrix} x_1 \\ x_2 \\ x_3 \end{pmatrix}
              \in \mathbb{R}^3 \;\middle|\;
              x_1 + x_2 = 4
            \right\}
            </m>
          </p>
        </statement></task><task><statement>
          <p>
            <m>
            \left\{
              \begin{pmatrix} x_1 \\ x_2 \\ x_3 \end{pmatrix}
              \in \mathbb{R}^3 \;\middle|\;
              x_1 + x_2 + x_3 = 0,\ x_1 + 2x_2 = 0
            \right\}
            </m>
          </p>
        </statement></task><task><statement>
          <p>
            <m>
            \left\{
              \begin{pmatrix} x_1 \\ x_2 \\ x_3 \end{pmatrix}
              \in \mathbb{R}^3 \;\middle|\;
              x_1 \le x_2 \le x_3
            \right\}
            </m>
          </p>
        </statement></task><task><statement>
          <p> The null space of
            <m>
            A = 
            \begin{pmatrix}
              1 &amp; 0 \\ 
              2 &amp; 0 \\
              3 &amp; 0
            \end{pmatrix}
            </m>
          </p>
        </statement></task></exercise>

  </page>
</worksheet>