<?xml version="1.0" encoding="UTF-8"?>
<worksheet xml:id="section-6-2">
  <title>Worksheet 6.2, Orthogonal Sets</title>

  <page>

    <!-- Exercise 1 -->
    <exercise xml:id="section-6-2-ex-1" workspace="2in"><introduction>
      <p> Indicate whether the statements are true or false.</p>
      
    </introduction><task><statement>
          <p>
            If the columns of an <m>n \times n</m> matrix <m>A</m> are orthonormal,
            then the linear mapping <m>\vec{x} \mapsto A\vec{x}</m> preserves lengths.
          </p>
        </statement></task><task><statement>
          <p>
            If <m>P</m> is a stochastic matrix, then the columns of <m>P</m> have unit length.
          </p>
        </statement></task></exercise>

    <!-- Exercise 2 -->
    <exercise xml:id="section-6-2-ex-2" workspace="2in"><statement>
      <p> Write <m>\vec{y}</m> as the sum of a vector parallel to <m>\vec{u}</m>
      and a vector perpendicular to <m>\vec{u}</m>.</p>

      <p>
        <md>
        \vec{y} =
        \begin{pmatrix}
          -1 \\ -5 \\ 10
        \end{pmatrix},
        \quad
        \vec{u} =
        \begin{pmatrix}
          5 \\ -2 \\ 1
        \end{pmatrix}
        </md>
      </p>
    </statement></exercise>

    <!-- Exercise 3 -->
    <exercise xml:id="section-6-2-ex-3" workspace="3in"><statement>
      <p> Determine if <m>\vec{v}</m> and <m>\vec w</m> are in the subspace spanned by the orthogonal vectors <m>\vec{u}_1</m> and <m>\vec{u}_2</m>. If they are, identify their coordinates in that subspace.</p>

      <p>
        <md>
        \vec{v} =
        \begin{pmatrix}
          44 \\ 7 \\ 3
        \end{pmatrix},
        \quad
        \vec{w} =
        \begin{pmatrix}
          0 \\ -5 \\ 22
        \end{pmatrix},
        \quad
        \vec{u}_1 =
        \begin{pmatrix}
          1 \\ -2 \\ 2
        \end{pmatrix},
        \quad
        \vec{u}_2 =
        \begin{pmatrix}
          6 \\ -7 \\ -10
        \end{pmatrix}
        </md>
      </p>
    </statement></exercise>
  </page>
  <page>

    <!-- Exercise 4 -->
    <exercise xml:id="section-6-2-ex-4" workspace="2in"><introduction>
      <p> Give examples of the following.</p>
      
    </introduction><task><statement>
          <p>
            A matrix <m>A</m> in RREF such that
            <m>\dim\!\left((\mathrm{Row}(A))^\perp\right) = 1</m>
            and
            <m>\dim\!\left((\mathrm{Col}(A))^\perp\right) = 2</m>.
          </p>

          <p>
            <md>A = \begin{pmatrix} &amp; &amp; &amp; \\ &amp; &amp; &amp; \\ &amp; &amp; &amp; \end{pmatrix}</md>
            <!-- manually padded entries -->
          </p>
        </statement></task><task><statement>
          <p>
            Two linearly independent vectors <m>\vec{u}</m> and <m>\vec{v}</m> in <m>\mathbb{R}^3</m>
            with
            <m>\vec{u} \cdot \vec{x} = \vec{v} \cdot \vec{x} = 0</m>,
            where
            <m>\vec{x} =
            \begin{pmatrix} 1 \\ 1 \\ 1 \end{pmatrix}</m>. <md> \vec{u} = \begin{pmatrix} &amp; \\  &amp; \\ &amp;
           \end{pmatrix} \qquad \vec{v} = \begin{pmatrix} &amp; \\ &amp; \\ &amp;
           \end{pmatrix}</md>
          </p>
        </statement></task><task><statement>
          <p>
            A <m>3 \times 3</m> matrix <m>A</m> in RREF such that
            <m>(\mathrm{Null}(A))^\perp</m> is spanned by
            <m>
            \begin{pmatrix}
              1 \\ 0 \\ -2
            \end{pmatrix}
            </m>.
          </p>

          <p>
            <md>A = \begin{pmatrix} &amp; &amp; &amp; &amp; \\ &amp; &amp; &amp; &amp; \\ &amp; &amp; &amp; &amp; \end{pmatrix}</md>
            <!-- Manually added in more ampersands because they didn't pad the matrix length enough-->
          </p>
        </statement></task><task><statement>
          <p>
            A non‑zero vector <m>\vec{w}</m> whose projection onto <m>\mathrm{Col}(A)</m>
            is <m>\vec{w}</m>, where
            <m>
            A =
            \begin{pmatrix}
              1 &amp; 0 &amp; 0 \\
              0 &amp; 0 &amp; 1
            \end{pmatrix}
            </m>.
          </p>

          <p>
            <md>\vec{w} = \begin{pmatrix} &amp; \\ &amp; \\ &amp; \end{pmatrix}</md>
          </p>
        </statement></task></exercise>

  </page>
</worksheet>