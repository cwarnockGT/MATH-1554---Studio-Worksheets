<?xml version="1.0" encoding="UTF-8"?>
<worksheet xml:id="section-6-4">
  <title>Worksheet 6.4, The Gram–Schmidt Process</title>

  <page>

    <!-- Exercise 1 -->
    <exercise xml:id="section-6-4-ex-1" workspace="2in"><statement>
      <p> Compute the QR decomposition of 
        <m>
        A =
        \begin{pmatrix}
          1 &amp; 5 \\
          3 &amp; 1 \\
          -2 &amp; 4
        \end{pmatrix}.
        </m>
      </p>
    </statement></exercise>

    </page>

    <page>

    <!-- Exercise 2 -->
    <exercise xml:id="section-6-4-ex-2" workspace="2in"><introduction>
      <p> Consider the three vectors below.</p>

      <p>
        <md>
        \vec{x}_1 =
        \begin{pmatrix}
          1 \\ 1 \\ 1 \\ 1 \\ 1
        \end{pmatrix},
        \quad
        \vec{x}_2 =
        \begin{pmatrix}
          2 \\ 1 \\ 0 \\ -1 \\ -2
        \end{pmatrix},
        \quad
        \vec{x}_3 =
        \begin{pmatrix}
          4 \\ 1 \\ 1 \\ 1 \\ 4
        \end{pmatrix}
        </md>
      </p>
      
    </introduction><task><statement>
          <p>
            The pair of vectors <m>\vec{x}_1</m> and <m>\vec{x}_2</m> are orthogonal.
            Which other pairs of vectors are orthogonal?
          </p>
        </statement></task><task><statement>
          <p>
            Use the vectors above, in that order, to construct three orthogonal
            vectors using the Gram–Schmidt process.
          </p>
        </statement></task></exercise>

  </page>
</worksheet>