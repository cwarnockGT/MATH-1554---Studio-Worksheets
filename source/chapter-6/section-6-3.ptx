<?xml version="1.0" encoding="UTF-8"?>
<worksheet xml:id="section-6-3">
  <title>Worksheet 6.3, Orthogonal Projections</title>

  <page>

    <!-- Exercise 1 -->
    <exercise xml:id="section-6-3-ex-1" workspace="2in"><introduction>
      <p>Let 
        <md>
        \vec{y} =
        \begin{pmatrix}
          0 \\ 2 \\ 4
        \end{pmatrix},
        \quad
        \vec{u}_1 =
        \begin{pmatrix}
          1 \\ 1 \\ 0
        \end{pmatrix},
        \quad
        \vec{u}_2 =
        \begin{pmatrix}
          -1 \\ 1 \\ 0
        \end{pmatrix}
        </md>
      </p>
      
    </introduction><task><statement><p>Determine whether <m>\vec{u}_1</m> and <m>\vec{u}_2</m> are:</p>
          <ul>
            <li>
              <p>
                are linearly independent.
              </p>
            </li>

            <li>
              <p>
                are mutually orthogonal.
              </p>
            </li>

            <li>
              <p>
                are orthonormal.
              </p>
            </li>

            <li>
              <p>
                span <m>\mathbb{R}^3</m>.
              </p>
            </li>
          </ul></statement></task><task><statement><p>Is <m>\vec{y}</m> in <m>\text{Span}\{ \vec{u_{1}}, \vec{u_{2} } \}</m>?</p></statement></task><task><statement><p>Compute the vector <m>\hat{y} \in W</m> that most closely approximates <m>\vec{y}</m>.</p></statement></task><task><statement><p>Construct a vector <m>\vec{z}</m> that is in <m>W^\perp</m>.</p></statement></task></exercise>

    <!-- Exercise 2 -->
     <exercise xml:id="section-6-3-ex-2" workspace="2in"><introduction>
      <p> Indicate whether the statements are true or false.</p>
      
    </introduction><task><statement><p>If <m>\vec{y}</m> is in a subspace <m>W</m>, the orthogonal projection of <m>\vec{y}</m> onto <m>W</m> is <m>\vec{y}</m>.</p></statement></task><task><statement><p>If <m>\vec{x}</m> is orthogonal to <m>\vec{v}</m> and <m>\vec{w}</m>, then <m>\vec{x}</m> is also orthogonal to <m>\vec{v} - \vec{w}</m>.</p></statement></task></exercise>

  </page>

  <page>
    
    <exercise xml:id="section-6-3-ex-3" workspace="2in"><introduction>
      <p> The set <m>\{\vec{v}_1,\vec{v}_2,\vec{v}_3\}</m> is an orthogonal basis for a subspace <m>V</m>.
      Classify each set as a basis for <m>V</m>, an orthogonal basis for <m>V</m>, or not a basis for <m>V</m>.</p>
      
    </introduction><task><statement><p><m>\{3\vec{v}_3,\ 2\vec{v}_1,\ \vec{v}_2\}</m></p></statement></task><task><statement><p><m>\{(\vec{v}_1 + \vec{v}_2),\ (\vec{v}_1 - \vec{v}_2),\ \vec{v}_3\}</m></p></statement></task><task><statement><p><m>\{(\vec{v}_1 + \vec{v}_2),\ (\vec{v}_1 - \vec{v}_2),\ (\vec{v}_3 - \vec{v}_1)\}</m></p></statement></task></exercise>

    <!-- Exercise 3 -->
    
    <!-- Exercise 4 -->
    <exercise xml:id="section-6-3-ex-4" workspace="2in"><introduction>
      <p> If possible, give an example of:</p>
      
    </introduction><task><statement><p>two linearly independent vectors that are orthogonal to <m>\begin{pmatrix}2 \\ 0 \\ -1\end{pmatrix}</m>.</p></statement></task><task><statement><p>a subspace <m>S \subset \mathbb{R}^3</m> such that <m>\dim(S^\perp) = 2</m>.</p></statement></task></exercise>

  </page>
</worksheet>